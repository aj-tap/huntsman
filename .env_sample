# REQUIRED: Generate a strong random string (e.g., using `openssl rand -hex 32`)
SECRET_KEY=change_this_to_a_very_long_random_string
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# --- Database ---
POSTGRES_DB=huntsman_db
POSTGRES_USER=huntsman_user
POSTGRES_PASSWORD=strong_password_123
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis & Celery ---
CACHE_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- Celery Resource Tuning ---
# Controls the number of worker processes. 
# Formula: (Available RAM - Overhead) / RAM per Worker
# Default: 2
CELERY_WORKER_CONCURRENCY=2

# Prevents the worker from reserving too many tasks at once.
# Default: 1 (recommended for long running tasks)
CELERY_WORKER_PREFETCH_MULTIPLIER=1

# Restarts the worker process after this many tasks to cure memory leaks.
# Default: 50
CELERY_WORKER_MAX_TASKS_PER_CHILD=50

# Maximum memory (in KB) a worker can use before being killed and replaced.
# Default: 1000000 (1GB)
CELERY_WORKER_MAX_MEMORY_PER_CHILD=1000000
CELERY_ACKS_LATE=True

# --- Localization & Time ---
CELERY_TIMEZONE=UTC
TIME_ZONE=UTC
USE_I18N=True
USE_TZ=True

# --- SuperDB ---
SUPERDB_BASE_URL=http://superdb:9867

# --- Frontend Behavior ---
# Limits the number of IOCs a user can submit at once from the dashboard.
# Default: 20
MAX_IOC_SUBMISSION_LIMIT=20

# --- Monitoring (Flower) ---
UI_USERNAME=admin
UI_PASSWORD=admin_password

# --- External APIs ---
VIRUSTOTAL_API_KEY=
OTX_API_KEY=
SHODAN_API_KEY=
ABUSEIPDB_API_KEY=
IPINFO_API_KEY=
PROXYCHECKIO_API_KEY=
HUNTERHOW_API_KEY=
BRAVE_NEWS_API_KEY=
DNSDUMPSTER_API_KEY=
CENSYS_API_KEY=
FOFA_API_KEY=
INTELXIO_API_KEY=
RANSOMWARELIVE_API_KEY=
# AbuseCH
THREATFOX_API_KEY=
MALWAREBAZAAR_API_KEY=
URLHAUS_API_KEY=
DEHASHED_API_KEY=

# --- AI Models ---
LITELLM_MODEL=
LITELLM_API_KEY=
LITELLM_API_BASE=
  
